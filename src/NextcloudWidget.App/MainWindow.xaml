<Window x:Class="NextcloudWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nextcloud 小窗"
        Width="436" Height="610"
        MinWidth="370" MinHeight="390"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F8F8"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=ViewTabs}">

  <Window.Resources>

    <Style x:Key="AppButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#33474C"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9D8D8"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="MinHeight" Value="25"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EFF6F6"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#AFC9C7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E2EEEE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#4F8B87"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#2F6F6B"/>
      <Setter Property="BorderBrush" Value="#275D5A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A817C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#275D5A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#BFE0DD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PinToggleStyle" TargetType="CheckBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#33474C"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9D8D8"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="MinHeight" Value="25"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EFF6F6"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#AFC9C7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E2EEEE"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2F6F6B"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#275D5A"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#7FB0AC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="TaskItemTemplate">
      <Border Background="#FFFFFF"
              BorderBrush="#E3ECEC"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,7,10,8"
              Margin="2,2"
              SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock x:Name="Title"
                     Grid.Row="0" Grid.Column="0"
                     Text="{Binding Title}"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="#22333A"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>

          <Border x:Name="StateBadge" Grid.Row="0" Grid.Column="1"
                  Background="#E7F2F1"
                  BorderBrush="#CBE2E0"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="7,2"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center">
            <TextBlock x:Name="StateText"
                       Text="{Binding StateText}"
                       FontSize="10"
                       Foreground="#2F6F6B"/>
          </Border>

          <TextBlock x:Name="DetailText"
                     Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding DetailText}"
                     FontSize="11"
                     Foreground="#66797D"
                     Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis"/>

          <TextBlock x:Name="DueText"
                     Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding DueText}"
                     FontSize="10.5"
                     Foreground="#8A9EA1"
                     Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateText}" Value="">
          <Setter TargetName="StateBadge" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DueText}" Value="">
          <Setter TargetName="DueText" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="MailItemTemplate">
      <Border Background="#FFFFFF"
              BorderBrush="#E3ECEC"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,7,10,8"
              Margin="2,2"
              SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock x:Name="Subject"
                     Grid.Row="0" Grid.Column="0"
                     Text="{Binding Subject}"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="#22333A"
                     TextTrimming="CharacterEllipsis"/>

          <TextBlock x:Name="DateText"
                     Grid.Row="0" Grid.Column="1"
                     Text="{Binding DateText}"
                     FontSize="10.5"
                     Foreground="#8A9EA1"
                     Margin="8,1,0,0"
                     VerticalAlignment="Top"/>

          <TextBlock x:Name="Sender"
                     Grid.Row="1" Grid.Column="0"
                     Text="{Binding Sender}"
                     FontSize="11"
                     Foreground="#66797D"
                     Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis"/>

          <Border Grid.Row="1" Grid.Column="1"
                  Background="#2F6F6B"
                  CornerRadius="9"
                  Padding="7,2"
                  Margin="8,3,0,0"
                  VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UnreadText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding UnreadText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock x:Name="UnreadText"
                       Text="{Binding UnreadText}"
                       FontSize="10"
                       Foreground="#FFFFFF"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="ListContainerStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#22333A"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="1"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#BFD8D6"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E3F0EF"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#9EC4C0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#4F8B87"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#5F7377"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="bd"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0,0,0,2"
                    CornerRadius="4,4,0,0"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header"
                                RecognizesAccessKey="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EDF5F5"/>
                <Setter Property="Foreground" Value="#3C5257"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#2F6F6B"/>
                <Setter Property="Foreground" Value="#1F2F33"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True"/>
                  <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="#9CC3C0"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E2ECEC"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="PinButton"
                  Grid.Column="0"
                  Style="{StaticResource PinToggleStyle}"
                  Content="置顶"
                  Click="Pin_Click"
                  ToolTip="保持窗口在最前"
                  VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Margin="10,0,0,1" VerticalAlignment="Center">
          <TextBlock Text="Nextcloud"
                     FontSize="13.5"
                     FontWeight="SemiBold"
                     Foreground="#22333A"/>
        </StackPanel>

        <Button x:Name="SyncNowButton"
                Grid.Column="2"
                Style="{StaticResource AccentButtonStyle}"
                Content="同步"
                Click="Refresh_Click"
                ToolTip="立即同步 Nextcloud 数据"
                Margin="0,0,6,0"
                VerticalAlignment="Center"/>

        <Button x:Name="SettingsButton"
                Grid.Column="3"
                Style="{StaticResource AppButtonStyle}"
                Content="设置"
                Click="OpenSettings_Click"
                ToolTip="打开设置"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <TabControl x:Name="ViewTabs" Grid.Row="1" Margin="10,8,10,10">

      <TabItem x:Name="TasksTab" Header="待办" IsSelected="True">
        <Border Background="#FFFFFF"
                BorderBrush="#DFE9E9"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,6,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,8,10,6">
              <DockPanel Margin="0,0,0,7">
                <CheckBox x:Name="ShowCompleted" DockPanel.Dock="Right" Content="显示已完成"
                          IsChecked="False" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ComboBox x:Name="ListFilter" MinHeight="25" MaxDropDownHeight="220"
                    AutomationProperties.Name="筛选任务清单" ToolTip="筛选任务清单"/>
              </DockPanel>
              <WrapPanel>
                <Button x:Name="CreateButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="新建"
                        Click="NewTask_Click"
                        ToolTip="新建任务"
                        Margin="0,0,6,0"/>
                <Button x:Name="EditButton"
                        Style="{StaticResource AppButtonStyle}"
                        Content="编辑"
                        Click="EditTask_Click"
                        ToolTip="编辑所选任务"
                        Margin="0,0,6,0"/>
                <Button x:Name="CompleteButton"
                        Style="{StaticResource AppButtonStyle}"
                        Content="完成"
                        Click="CompleteTask_Click"
                        ToolTip="将所选任务标记为已完成"
                        Margin="0,0,6,0"/>
                <Button x:Name="ResolveButton"
                        Style="{StaticResource AppButtonStyle}"
                        Content="解决冲突"
                        Click="ResolveTask_Click"
                        ToolTip="比较本地和服务器上的更改"/>
              </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="1">
              <ListBox x:Name="TasksList"
                       ItemTemplate="{StaticResource TaskItemTemplate}"
                       ItemContainerStyle="{StaticResource ListContainerStyle}"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionMode="Single"
                       Margin="4,0,4,4"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Margin="8,8,0,2" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#36585C"/>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
              </ListBox>
              <TextBlock x:Name="TasksEmpty"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Foreground="#556C70"
                         IsHitTestVisible="False"
                         Margin="10" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FAFCFC"
                    BorderBrush="#E6EFEF"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7"
                    Padding="10,5">
              <TextBlock x:Name="TaskStatus"
                         Text="就绪"
                         FontSize="11"
                         Foreground="#64797D"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <TabItem x:Name="MailTab" Header="邮件">
        <Border Background="#FFFFFF"
                BorderBrush="#DFE9E9"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,6,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="10,8,10,8" LastChildFill="False">
              <Button x:Name="ReadButton"
                      DockPanel.Dock="Left"
                      Style="{StaticResource AppButtonStyle}"
                      Content="阅读邮件"
                      Click="ReadMail_Click"
                      ToolTip="打开所选邮件的正文"/>
              <TextBlock DockPanel.Dock="Right"
                         Text="双击打开邮件"
                         FontSize="10.5"
                         Foreground="#93A7AA"
                         VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1">
              <ListBox x:Name="MailList"
                       ItemTemplate="{StaticResource MailItemTemplate}"
                       ItemContainerStyle="{StaticResource ListContainerStyle}"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionMode="Single"
                       Margin="4,0,4,4"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       MouseDoubleClick="Mail_DoubleClick"/>
              <TextBlock x:Name="MailEmpty"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Foreground="#556C70"
                         IsHitTestVisible="False"
                         Margin="10" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FAFCFC"
                    BorderBrush="#E6EFEF"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7"
                    Padding="10,5">
              <TextBlock x:Name="MailStatus"
                         Text="就绪"
                         FontSize="11"
                         Foreground="#64797D"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
