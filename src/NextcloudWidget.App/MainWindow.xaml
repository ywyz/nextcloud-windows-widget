<Window x:Class="NextcloudWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nextcloud 小窗" WindowStartupLocation="CenterScreen"
        Icon="Assets/Widget.ico"
        Width="460"
        Height="625"
        MinWidth="370"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ContentRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="1">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Background="Transparent">
                            <Image Source="Assets/Widget.png" Width="23" Height="23"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Nextcloud"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <Button x:Name="ThemeButton"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Theme_Click"
                                    MinWidth="34"
                                    MinHeight="26"
                                    Margin="0,0,6,0"
                                    ToolTip="切换主题"
                                    AutomationProperties.Name="切换主题" />
                            <CheckBox x:Name="PinButton" MinWidth="0"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                      Content="置顶"
                                      Click="Pin_Click"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      ToolTip="窗口置顶"
                                      AutomationProperties.Name="窗口置顶" />
                            <Button x:Name="HideButton"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Content="收起"
                                    Click="Hide_Click"
                                    MinHeight="26"
                                    ToolTip="收起窗口"
                                    AutomationProperties.Name="收起窗口" />
                        </StackPanel>
                    </Grid>


                </Grid>
            </Border>

            <TabControl x:Name="ViewTabs"
                        Grid.Row="1"
                        Margin="8,0,8,0"
                        Background="Transparent"
                        BorderThickness="0">

                <TabItem x:Name="TasksTab" Header="待办" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Margin="12,8,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickTitle"
                                     Grid.Column="1"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"
                                     KeyDown="QuickTitle_KeyDown"
                                     TextChanged="QuickTitle_Changed"
                                     ToolTip="输入标题，按 Enter 添加"
                                     AutomationProperties.Name="任务标题" />
                            <TextBlock Grid.Column="1" Text="新增待办，按回车添加" Margin="9,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text,ElementName=QuickTitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="CreateButton"
                                    Grid.Column="2"
                                    Content="添加"
                                    Click="NewTask_Click"
                                    MinWidth="64"
                                    Margin="8,0,0,0"
                                    ToolTip="添加待办" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="添加到"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="QuickList"
                                          Width="116" AutomationProperties.Name="新待办的目标清单"
                                          MinHeight="26"
                                          ToolTip="选择目标清单" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="筛选"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="ListFilter"
                                          Width="100" AutomationProperties.Name="筛选任务清单"
                                          MinHeight="26"
                                          ToolTip="筛选视图" />
                            </StackPanel>
                            <CheckBox x:Name="ShowCompleted" MinWidth="0"
                                      Content="显示已完成"
                                      VerticalAlignment="Center"
                                      Margin="14,0,0,0" />
                        </WrapPanel>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <ListBox x:Name="TasksList" ItemContainerStyle="{StaticResource ContentRow}"
                                     SelectionMode="Single"
                                     HorizontalContentAlignment="Stretch"
                                     Background="{DynamicResource SurfaceBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}"
                                     BorderThickness="1"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="2,6,0,2"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Title"
                                                       Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock x:Name="StateText"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       Text="{Binding StateText}"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock x:Name="DetailText"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Text="{Binding DetailText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock x:Name="DueText"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="8,2,0,0"
                                                       FontSize="11"
                                                       Text="{Binding DueText}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TasksEmpty"
                                       Text="暂无待办"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Grid>

                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button x:Name="EditButton"
                                    Content="编辑"
                                    Click="EditTask_Click"
                                    MinWidth="68" />
                            <Button x:Name="CompleteButton"
                                    Content="完成"
                                    Click="CompleteTask_Click"
                                    MinWidth="68"
                                    Margin="8,0,0,0" />
                            <Button x:Name="ResolveButton"
                                    Content="解决"
                                    Click="ResolveTask_Click"
                                    MinWidth="68"
                                    Margin="8,0,0,0" />
                        </WrapPanel>

                        <TextBlock x:Name="TaskStatus"
                                   Grid.Row="4"
                                   Margin="2,8,2,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                </TabItem>

                <TabItem x:Name="MailTab" Header="邮件" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Margin="12,8,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button x:Name="SelectMailButton"
                                    Content="全选"
                                    Click="SelectMail_Click"
                                    MinWidth="64" />
                            <Button x:Name="ReadButton"
                                    Content="阅读"
                                    Click="ReadMail_Click"
                                    MinWidth="64"
                                    Margin="8,0,0,0" />
                            <Button x:Name="MarkReadButton"
                                    Content="标为已读"
                                    Click="MarkRead_Click"
                                    MinWidth="76"
                                    Margin="8,0,0,0" />
                            <Button x:Name="TrashButton"
                                    Content="移到废纸篓" Foreground="{DynamicResource DangerBrush}"
                                    Click="Trash_Click"
                                    MinWidth="88"
                                    Margin="8,0,0,0" />
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <ListBox x:Name="MailList" ItemContainerStyle="{StaticResource ContentRow}"
                                     SelectionMode="Extended"
                                     MouseDoubleClick="Mail_DoubleClick"
                                     HorizontalContentAlignment="Stretch"
                                     Background="{DynamicResource SurfaceBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}"
                                     BorderThickness="1"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="1,0,8,0" Width="24" MinWidth="0" Padding="0"
                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Subject, StringFormat=选择邮件 {0}}"/>
                                            <Grid Margin="6,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Subject"
                                                       Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Subject}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock x:Name="UnreadText"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       Text="{Binding UnreadText}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock x:Name="Sender"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Text="{Binding Sender}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock x:Name="DateText"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="8,2,0,0"
                                                       FontSize="11"
                                                       Text="{Binding DateText}"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Grid>
                                    </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="MailEmpty"
                                       Text="暂无邮件"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Grid>

                        <TextBlock x:Name="MailStatus"
                                   Grid.Row="2"
                                   Margin="2,8,2,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                </TabItem>
            </TabControl>
                    <Grid Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SyncNowButton"
                                    Content="同步"
                                    Click="Refresh_Click"
                                    MinWidth="64"
                                    MinHeight="26"
                                    ToolTip="立即同步"
                                    AutomationProperties.Name="立即同步" />
                            <Button x:Name="SettingsButton"
                                    Content="设置"
                                    Click="OpenSettings_Click"
                                    MinWidth="64"
                                    MinHeight="26"
                                    Margin="8,0,0,0"
                                    ToolTip="打开设置"
                                    AutomationProperties.Name="打开设置" />
                        </StackPanel>
                    </Grid>
        </Grid>
    </Border>
</Window>
